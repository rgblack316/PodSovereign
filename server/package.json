{
  "name": "podsovereign-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted podcast feed host: import, replicate and serve RSS with full iTunes + Podcasting 2.0 support",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "ALLOW_PRIVATE_NETWORKS=1 MEDIA_DIR=./.scratch/media node --import tsx --watch src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/feed.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "tsx src/cli/preview.ts",
    "demo": "tsx test/support/demo.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "sax": "^1.4.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/sax": "^1.2.7",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
