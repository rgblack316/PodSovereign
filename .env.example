# Copy to .env (install.sh does this for you) and keep it private.

# Database password (install.sh generates a random one).
POSTGRES_PASSWORD=change-me

# The address listeners and apps use. You can change it later in Site settings.
PUBLIC_BASE_URL=https://podcasts.example.com

# Port on this machine (127.0.0.1 only) that the app listens on.
FEEDHOST_PORT=8080

# Where copied media and the uploaded logo/favicon are stored on this machine.
FEEDHOST_DATA_DIR=./data

# Optional: Cloudflare Tunnel run by Docker. Paste the token from
# Cloudflare Zero Trust → Networks → Tunnels → (your tunnel) → install command,
# and set COMPOSE_PROFILES=tunnel. Point the public hostname at http://app:8080
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=

# Optional starting values (Site settings in the dashboard override these).
SITE_NAME=PodSovereign
ALLOW_REGISTRATION=false
# Podping goes through the Podcast Index hub (no key needed). Each show has its own switch.

# Set by install.sh / update.sh: the git commit that's running.
FEEDHOST_VERSION=dev
